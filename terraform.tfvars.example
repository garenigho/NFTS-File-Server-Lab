location       = "Central US"
rdp_source     = "YOUR_PUBLIC_IP/32"   # Find yours at whatismyip.com, format: 1.2.3.4/32
server_vm_size = "Standard_D2s_v6"
client_vm_size = "Standard_D2s_v6"

# admin_password is NOT set here. Use an environment variable:
#   PowerShell: $env:TF_VAR_admin_password = "YourStrongPassword!"
# Min 12 chars, upper + lower + number + symbol.